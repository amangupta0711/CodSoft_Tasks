datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  JOB_SEEKER
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum ExperienceLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR
  LEAD_EXECUTIVE
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobStatus {
  PUBLISHED
  CLOSED
  ARCHIVED
  DRAFT
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
  WITHDRAWN
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  password        String
  name            String
  role            Role              @default(JOB_SEEKER)
  phone           String?
  avatar          String?
  status          UserStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  jobSeekerProfile JobSeekerProfile?
  recruiterProfile RecruiterProfile?
  applications     JobApplication[]
  savedJobs        SavedJob[]
  postedJobs       Job[]             @relation("RecruiterJobs")
  statusChanges    ApplicationStatusHistory[]
}

model JobSeekerProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  headline           String?
  bio                String?
  location           String?
  skills             String?          // Comma-separated or JSON string
  portfolioUrl       String?
  linkedInUrl        String?
  gitHubUrl          String?
  resumePath         String?
  resumeOriginalName String?
  resumeUploadedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  education          Education[]
  experience         WorkExperience[]
}

model Education {
  id           String           @id @default(uuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  current      Boolean          @default(false)
  grade        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id          String           @id @default(uuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean          @default(false)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  profile     JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Company {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  logo        String?
  description String?
  industry    String?
  website     String?
  location    String?
  size        String?            // e.g. "50-200 employees"
  foundedYear Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  recruiters  RecruiterProfile[]
  jobs        Job[]
}

model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  companyId String
  title     String?  // e.g. "Lead Technical Recruiter"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Job {
  id               String          @id @default(uuid())
  title            String
  slug             String
  companyId        String
  recruiterId      String
  description      String
  responsibilities String          // Stored as formatted markdown or JSON text
  requirements     String          // Stored as formatted markdown or JSON text
  skills           String          // Comma-separated or JSON array of strings
  employmentType   EmploymentType  @default(FULL_TIME)
  experienceLevel  ExperienceLevel @default(MID_LEVEL)
  workArrangement  WorkArrangement @default(REMOTE)
  location         String
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String          @default("INR")
  deadline         DateTime?
  status           JobStatus       @default(PUBLISHED)
  featured         Boolean         @default(false)
  category         String          @default("Engineering")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter        User            @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)
  applications     JobApplication[]
  savedBy          SavedJob[]

  @@index([category])
  @@index([status])
  @@index([location])
  @@index([employmentType])
}

model JobApplication {
  id                 String                   @id @default(uuid())
  jobId              String
  applicantId        String
  coverLetter        String?
  resumePath         String
  resumeOriginalName String
  status             ApplicationStatus        @default(APPLIED)
  notes              String?                  // Internal recruiter notes
  interviewDate      DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  job                Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant          User                     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  statusHistory      ApplicationStatusHistory[]

  @@unique([jobId, applicantId])
  @@index([status])
  @@index([jobId])
  @@index([applicantId])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  note          String?
  createdAt     DateTime          @default(now())

  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User              @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  createdAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}
