# CareerHub PostgreSQL Database Connection String
# Local PostgreSQL default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerhub?schema=public"

# Managed Cloud PostgreSQL examples (Neon, Supabase, Railway):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-sample-1234.us-east-2.aws.neon.tech/careerhub?sslmode=require"

# Session JWT Authentication Secret (32+ chars)
JWT_SECRET="careerhub-production-jwt-session-secret-key-2026-codsoft-task3"

# Resume Storage Directory (private local storage or mounted volume)
RESUME_STORAGE_DIR="./storage/resumes"

# Application Configuration
NEXT_PUBLIC_APP_NAME="CareerHub"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
PORT=3001
