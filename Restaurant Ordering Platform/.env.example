# DineDesk PostgreSQL Connection String
# Formats:
# Local PostgreSQL: postgresql://postgres:YOUR_PASSWORD@localhost:5432/dinedesk?schema=public
# Managed Cloud (Neon, Supabase, Railway): postgresql://USER:PASSWORD@HOST:5432/dinedesk?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinedesk?schema=public"

# Session & JWT secret
JWT_SECRET="dinedesk-ultra-secure-jwt-secret-key-32charsmin-2026"

# Restaurant settings
NEXT_PUBLIC_APP_NAME="DineDesk"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DELIVERY_FEE="40"
NEXT_PUBLIC_TAX_RATE="0.05"
